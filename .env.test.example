# Environment Configuration - Test
# Used by docker-compose.test.yml when running containerized test stack
#
# Note: These are the defaults used in docker-compose.test.yml
# You can override by setting these variables before running docker compose

# Database
DATABASE_URL=postgresql://user:pwd@localhost:port/db
# CORS
CORS_ORIGINS=http://localhost:3001,http://frontend_test:80

# Frontend API URL (baked into Docker image at build time)
VITE_API_URL=http://localhost:8001
