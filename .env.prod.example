# Environment Configuration - Production
# Copy this file to .env.prod and fill in the values
#
# ⚠️ NEVER commit .env.prod to version control!

# Database - Use strong credentials in production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# CORS - Specify allowed origins (comma-separated)
# CORS_ORIGINS=https://your-domain.com
CORS_ORIGINS=

# PostgreSQL credentials (used by docker-compose.prod.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
