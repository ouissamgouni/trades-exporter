# Environment Configuration - Development
# This file is used for local development with code running outside Docker
#
# Usage: Set DATABASE_URL in terminal or VSCode launch.json
#        The Taskfile automatically sets this for dev commands

# Database
DATABASE_URL=postgresql://user:pwd@localhost:port/db

# CORS (allow all in development)
CORS_ORIGINS=*

# Frontend API URL (for Vite)
VITE_API_URL=http://localhost:8000
