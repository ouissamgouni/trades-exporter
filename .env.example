# =============================================
# Trade Exporter - Environment Configuration Template
# =============================================
# Copy this file to create your environment-specific .env files:
#   - .env (common variables for all environments)
#   - .env.dev (development overrides)
#   - .env.test (test overrides)
#   - .env.prod (production overrides)
#
# DO NOT commit files with actual credentials to git!
# =============================================

# =============================================
# Environment Identifier
# =============================================
# Identifies which environment the application is running in
# Values: dev, test, prod
# Used for: Environment detection, logging, UI badges
ENV_NAME=dev

# =============================================
# Application Settings (Common)
# =============================================
BASE_CURRENCY=EUR
LOG_LEVEL_ROOT=WARNING
LOG_LEVEL_TRADE_EXPORTER=DEBUG

# =============================================
# Database Configuration
# =============================================
# Option 1: Use individual variables (will be combined into DATABASE_URL)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=trades_db_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Option 2: Use full DATABASE_URL (takes precedence if set)
# DATABASE_URL=postgresql://user:password@host:port/database

# =============================================
# Exchange API Credentials
# =============================================

# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# MEXC
MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret

# OKX
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_API_PASSPHRASE=your_okx_passphrase

# Coinbase
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_API_SECRET=your_coinbase_api_secret

# =============================================
# Web3 / Blockchain Configuration
# =============================================
ETHERSCAN_API_KEY=your_etherscan_api_key

# CoinGecko API Keys (comma-separated for multiple keys)
COINGECKO_API_KEYS=your_coingecko_key_1,your_coingecko_key_2

# =============================================
# Notes
# =============================================
# - Variables in .env are common to all environments
# - Variables in .env.{dev|test|prod} override common ones
# - Taskfile loads: [".env", ".env.{environment}"] for each task
# - Cloud deployments should inject secrets via platform (not .env files)
