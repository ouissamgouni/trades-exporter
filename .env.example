# Environment Configuration Template
# Copy this file to .env.dev, .env.test, or .env.prod and fill in actual values
# DO NOT commit files with actual credentials

# Development Environment
DEV_DB_USER=your_db_user
DEV_DB_PASSWORD=your_secure_password
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_NAME=trades_db_dev

# Test Environment
TEST_DB_USER=your_db_user
TEST_DB_PASSWORD=your_secure_password
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=trades_db_test

# Production Environment
PROD_DB_USER=your_db_user
PROD_DB_PASSWORD=your_secure_password
PROD_DB_HOST=localhost
PROD_DB_PORT=5434
PROD_DB_NAME=trades_db_prod
