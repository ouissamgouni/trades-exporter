# ════════════════════════════════════════════════════════════════
# BASE CONFIG — committed, no secrets
# Universal defaults applied in all environments.
# Override in config/dev.env, config/staging.env, config/prod.env, etc.
# ════════════════════════════════════════════════════════════════

# ── App defaults ─────────────────────────────────────────────────
BASE_CURRENCY=EUR
LOG_LEVEL_ROOT=WARNING
LOG_LEVEL_TRADE_EXPORTER=DEBUG

# ── Database defaults (local dev/test/scenario) ──────────────────
# Remote environments (staging.remote, prod.remote) override DATABASE_URL
# in config/secrets.staging.env / config/secrets.prod.env.
POSTGRES_USER=trades_user
POSTGRES_PASSWORD=trades_password

# ── Uvicorn ──────────────────────────────────────────────────────
# JSON list of paths to exclude from access logs. Use [] to log everything.
UVICORN_ACCESS_LOG_EXCLUDE_PATHS=["/sync-job/status", "/config/setup-status"]
