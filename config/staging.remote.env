# ════════════════════════════════════════════════════════════════
# REMOTE STAGING CONFIG — committed, no secrets
# Used by: task deploy:staging:remote (Fly.io backend + Cloudflare Pages frontend
# + Neon Postgres). For credentials see config/secrets.staging.env.
# ════════════════════════════════════════════════════════════════

ENV_NAME=staging

# ── Fly.io ──────────────────────────────────────────────────────
FLY_APP_BACKEND=trades-exporter-staging
FLY_CONFIG=fly.staging.toml
FLY_BACKEND_URL=https://trades-exporter-staging.fly.dev

# ── Cloudflare Pages ────────────────────────────────────────────
CLOUDFLARE_PAGES_PROJECT=trades-exporter
CLOUDFLARE_PAGES_BRANCH=develop
CLOUDFLARE_PAGES_URL=https://develop.trades-exporter.pages.dev

# ── Frontend build args (consumed by `npm run build`) ───────────
VITE_API_URL=https://trades-exporter-staging.fly.dev
