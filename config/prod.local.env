# ════════════════════════════════════════════════════════════════
# LOCAL PROD CONFIG — committed, no secrets
# Production runs locally only (docker-compose); there is no remote hosting.
# Used by: task start:prod:local, task deploy:prod:local:*, task release:prod:*.
# Loading order: config/base.env → config/prod.local.env → config/secrets.env
#                → config/secrets.prod.local.env
# ════════════════════════════════════════════════════════════════

ENV_NAME=prod
IMAGE_TAG=prod

# ── Database (local Docker container) ────────────────────────────
POSTGRES_DB=trades_db_prod
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Explicit DATABASE_URL for host-side tasks (the backend container overrides it).
DATABASE_URL=postgresql://trades_user:trades_password@localhost:5434/trades_db_prod

# ── Ports ────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ── Application Settings Overrides ───────────────────────────────
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_TRADE_EXPORTER=INFO
