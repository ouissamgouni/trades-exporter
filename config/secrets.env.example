# ════════════════════════════════════════════════════════════════
# SHARED SECRETS — gitignored
# Copy to config/secrets.env and fill with real values.
# Loaded by every environment (dev/staging/prod/scenario).
# ════════════════════════════════════════════════════════════════

# ── Exchange API Credentials ────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

MEXC_API_KEY=
MEXC_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

COINBASE_API_KEY=
COINBASE_API_SECRET=

# ── Web3 / Blockchain ───────────────────────────────────────────
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
COINGECKO_API_KEYS=
MORALIS_API_KEY=
HELIUS_API_KEY=
CARDANOSCAN_API_KEY=
ANKR_API_KEY=
NEARBLOCKS_API_KEY=
TAOSTATS_API_KEY=

# ── Polymarket ──────────────────────────────────────────────────
# No credentials needed (public Data API). Proxy wallet with activity,
# used only by tests/integration/onchain/test_int_polymarket.py.
POLYMARKET_TEST_WALLET=

# ── Integration test fixtures (only needed to run @pytest.mark.integration) ─
# A Hyperliquid account address with existing trading history, used
# only by tests/integration/onchain/test_int_hyperliquid.py. Tests are
# skipped automatically if unset.
HYPERLIQUID_TEST_WALLET=
# EVM address with history, used by tests/integration/onchain/test_int_ankr.py.
ANKR_TEST_WALLET=
ANKR_TEST_CHAIN=arbitrum

