# ════════════════════════════════════════════════════════════════
# LOCAL STAGING CONFIG — committed, no real secrets
# Used by: task start:staging:local, task deploy:staging:local, etc. (docker-compose stack).
# Loading order: config/base.env → config/staging.local.env → config/secrets.env
#                → config/secrets.staging.local.env
# ════════════════════════════════════════════════════════════════

ENV_NAME=staging
IMAGE_TAG=develop

# ── Database (local Docker container) ────────────────────────────
POSTGRES_DB=trades_db_staging
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Explicit DATABASE_URL for host-side tasks (the backend container overrides it).
DATABASE_URL=postgresql://trades_user:trades_password@localhost:5433/trades_db_staging

# ── Ports ────────────────────────────────────────────────────────
BACKEND_PORT=8001
FRONTEND_PORT=3001
