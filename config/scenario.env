# ════════════════════════════════════════════════════════════════
# SCENARIO CONFIG — committed, no secrets
# Loaded by: task start:scenario, task db:seed:scenario, etc.
# Loading order: config/base.env → config/scenario.env → config/secrets.env → config/secrets.scenario.env
#                → scenarios/<name>/config.env → scenarios/<name>/secrets.env
#
# Actual ports are derived from the scenario name hash (see .taskfiles/scenario_ports.sh).
# Base values below are used only for the unnamed/default scenario.
# ════════════════════════════════════════════════════════════════

ENV_NAME=scenario
IMAGE_TAG=scenario

# ── Database (defaults; overridden by scenario_ports.sh) ────────
POSTGRES_DB=trades_db_scenario
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# ── Service Ports (defaults; overridden by scenario_ports.sh) ───
BACKEND_PORT=8002
FRONTEND_PORT=3002
