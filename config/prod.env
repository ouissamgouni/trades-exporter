# ════════════════════════════════════════════════════════════════
# LOCAL PROD CONFIG — committed, no secrets
# Used by: task start:prod (run prod images locally via docker-compose).
# For remote prod (Fly.io + Neon + Cloudflare Pages), see config/prod.remote.env
# and config/secrets.prod.env.
# ════════════════════════════════════════════════════════════════

ENV_NAME=prod
IMAGE_TAG=latest

# ── Database (local Docker container) ────────────────────────────
POSTGRES_DB=trades_db_prod
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# ── Ports ────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ── Application Settings Overrides ───────────────────────────────
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_TRADE_EXPORTER=INFO
