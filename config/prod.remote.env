# ════════════════════════════════════════════════════════════════
# REMOTE PROD CONFIG — committed, no secrets
# Used by: task deploy:prod:remote (Fly.io backend + Cloudflare Pages frontend
# + Neon Postgres). For credentials see config/secrets.prod.env.
# ════════════════════════════════════════════════════════════════

ENV_NAME=prod

# ── Fly.io ──────────────────────────────────────────────────────
FLY_APP_BACKEND=trades-exporter
FLY_CONFIG=fly.toml
FLY_BACKEND_URL=https://trades-exporter.fly.dev

# ── Cloudflare Pages ────────────────────────────────────────────
CLOUDFLARE_PAGES_PROJECT=trades-exporter
CLOUDFLARE_PAGES_BRANCH=main
CLOUDFLARE_PAGES_URL=https://trades-exporter.pages.dev

# ── Frontend build args ─────────────────────────────────────────
VITE_API_URL=https://trades-exporter.fly.dev
