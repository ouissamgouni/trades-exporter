# ════════════════════════════════════════════════════════════════
# DEV CONFIG — committed, no secrets
# Loaded by: task start:dev, task db:migrate:dev, etc.
# Loading order: config/base.env → config/dev.env → config/secrets.env → config/secrets.dev.env
# ════════════════════════════════════════════════════════════════

ENV_NAME=dev

# ── Database (local Docker container) ────────────────────────────
POSTGRES_DB=trades_db_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Ports ────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
DEBUGPY_PORT=5678
