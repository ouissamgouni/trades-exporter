# ════════════════════════════════════════════════════════════════
# LOCAL STAGING CONFIG — committed, no real secrets
# Used by: task start:staging:local, task deploy:staging:local, etc. (docker-compose stack).
# For remote staging (Fly.io + Neon + Cloudflare Pages), see config/staging.remote.env
# and config/secrets.staging.env.
# ════════════════════════════════════════════════════════════════

ENV_NAME=staging
IMAGE_TAG=develop

# ── Database (local Docker container) ────────────────────────────
POSTGRES_DB=trades_db_staging
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Explicit DATABASE_URL for local tasks — always points to localhost:5433.
DATABASE_URL=postgresql://trades_user:trades_password@localhost:5433/trades_db_staging

# ── Ports ────────────────────────────────────────────────────────
BACKEND_PORT=8001
FRONTEND_PORT=3001
